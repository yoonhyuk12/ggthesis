{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit|Bash|PowerShell|mcp__hwpx__.*",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/log_change.py\"",
            "timeout": 30,
            "statusMessage": "log.md 기록 중"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/session_brief.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
