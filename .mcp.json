{
  "mcpServers": {
    "hwpx": {
      "command": "hwpx-mcp-simple\\.venv\\Scripts\\hwpx-mcp-server.exe",
      "args": [],
      "env": {
        "HWPX_MCP_AUTOBACKUP": "1"
      }
    },
    "korean-law": {
      "command": "node",
      "args": [
        ".claude/korean-law-mcp/build/index.js"
